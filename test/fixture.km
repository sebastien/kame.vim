# Syntax fixture: comments, includes, definitions, rules, and recipes.
include ./rules/common.kmk
VERSION = "1.2.3"
SOURCES = (wildcard ./src/*.c)
MESSAGE = "building @(count SOURCES) sources"
COUNT = 1_000
RATIO = -3.5
CONFIG = [name: "app" path: ./src workers: 4 enabled: :true]
(source object) = (replace ./{**}/{*}.c ./build/{_0}/{_1}.o object)

default : ./build/app

./build/{name}.o : ./src/{name}.c
	cc -c @< -o @>
./build/app : ./build/main.o ./build/util.o
	cc @>* -o @> # link
./build/version.txt :
	@(yield "version 3\n")
task cached : ./build/app
	echo "cached $(date)"
service server : ./build/app
	./build/app --watch
report : ./build/app
	@(out "built @(count SOURCES) files\n")
	title="release @>-1"; echo "$title"
	if [ -f ./build/app ]; then
		cat <<-EOF
		first @< input
		EOF
	fi

clean :
	rm -rf ./build

// Second comment style.
