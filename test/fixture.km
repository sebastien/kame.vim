# Syntax fixture: comments, includes, definitions, expressions, references.
include ./rules/common.kmk
VERSION = "1.2.3"
SOURCES = (wildcard ./src/*.c)
MESSAGE = "building @(count SOURCES) sources"
COUNT = 1_000
RATIO = -3.5
CONFIG = [name: "app" path: ./src workers: 4 enabled: :true]
REF = project.name
SLICE = files.1..4
KEYS = config.{host,port}
SECTION = ((f _0 _1))
CMP = (< a b)
CAPTURE = $(git rev-parse --short HEAD)
(source object) = (replace ./{**}/{*}.c ./build/{_0}/{_1}.o object)

// Second comment style.
