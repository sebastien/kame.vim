# Syntax fixture: definitions, expressions, rules, and recipes.
MODE ?= "debug"
CHECKS += [./tests/unit]
import ./lib/toolchain as tools
from ./lib/config import mode-name as configured-mode
include ./rules/common.km
include? ./local.km
SOURCES = files ./src/**/*.c
mapper = (x => x + 1)
pairs = SOURCES |> map (ends? ".c" _)
selected = if ready then SOURCES else []
config = {name: "app", "key with space": 1, ...defaults}
root = @{module/dir}/templates/page.kmt
def object-path source = match source
	./src/{path:**}.c => ./build/@{path}.o
	else => nil
task deploy {environment} : ./seed
	let workspace = line $(mktemp -d)
	set env/MODE = mode
	for source from ./paths.list :lines
		echo source=$source
	defer rm -rf $workspace
rule ./build/{name}.o : ./src/{name}.c ; {shell: "bash", env: {MODE: mode}}
	@if minify
	strip @{inputs.0}
	@end
rule always (index-path) : @{pages} | ./stamp, ./generated
	cp @{inputs.0} @{outputs.0}
for variant in ["debug", "release"]
	rule ./build/@{variant}/{name}.o : ./src/{name}.c
		cc -c $inputs.0 -o $outputs.0
task comments
	echo https://example.com # a comment
flags = [true, false, nil, :release]
