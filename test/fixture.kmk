# Syntax fixture: rule headers, targets, selectors, and recipes.

default : ./build/app

./build/{name}.o : ./src/{name}.c
	cc -c @< -o @>
./build/app : ./build/main.o ./build/util.o
	cc @>* -o @> # link
./build/version.txt :
	@(yield! "version 3\n")
task cached : ./build/app
	echo "cached $(date)"
service server : ./build/app
	./build/app --watch
report : ./build/app
	@(out! "built @(count SOURCES) files\n")
	title="release @>-1"; echo "$title"
	if [ -f ./build/app ]; then
		cat <<-EOF
		first @< input
		EOF
	fi

clean :
	rm -rf ./build

// Second comment style.

directives : ./build/app
	@if(exists? ./build/app)
	echo yes
	@else
	echo no
	@end
	@raw
	@if(kept)
	@end

./out/{name:*}.o : ./src/{name}.c | ./stamp, ./generated
	cc -c @< -o @>

tools : ./build/app
	@{x/uv} run @{x/python} -m compileall
	echo changed:@<?

@{BUILD}/{name}.txt : @{SOURCES}/{name}.c
	cp @< @>

always ./build/staged : ./build/app
	cp @< @>
./build/alias <- ./build/app
	cp @< @>

task deploy {environment} {region=us-east} : ./seed
	echo ok
