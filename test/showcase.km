# Showcase: Kame program definitions and expressions.
MODE ?= "debug"
CHECKS += [./tests/unit]
import ./lib/toolchain as tools
from ./lib/config import mode-name as configured-mode
include ./rules/common.km
include? ./local.km

SOURCES = files ./src/**/*.c
FLAG = true
NOTHING = nil
COUNT = 1_000
RATIO = -3.5
HEX = 0xFF_00
BIN = 0b1010_01
OCT = 0o755
FLOAT = 1.5e-3
SYM = :my-symbol
SIGNS = [:+up, :-down]
MAPPER = (x => x + 1)
REST = (first rest... => first)
PAIRS = SOURCES |> map (ends? ".c" _)
JOINED = ["./main.c", "./util.c"] |> map (name => uppercase name) |> join ", "
SELECTED = if FLAG then SOURCES else []
CONFIG = {name: "app", "key with space": 1, ...defaults}
ROOT = @{module/dir}/templates/page.kmt
CAPTURE = $(git rev-parse --short HEAD)
OUTCOME = $?(git status --short)
ASYNC = $&(watch-assets)

def object-path source = match source
	./src/{path:**}.c => ./build/@{path}.o
	else => nil

def build source output
	cc -c $source -o $output

VERBATIM = """
raw @{literal} and @@ text
"""

# The end.
