<!DOCTYPE html>
<html
	<head
		<meta(charset=utf-8)
		<title:Showcase ― @(page.title)
	<body
		<h1 @(page.heading)
		<p: rendered by @(host.name) at {(VERSION)}
		<!-- @with(page.meta) -->
		<meta(name=description content=@(description))
		<!-- @end -->
		<!-- @if(page.posts) -->
		<ul
			<!-- @for([post] page.posts) -->
			<li
				<a(href=@(post.url)): @(post.title)
			<!-- @end -->
		<!-- @else -->
		<p: no posts
		<!-- @end -->
		<!-- @let([count] (count page.posts)) -->
		<footer:@(count) posts, first @<(page.posts) last @>-1
		<!-- @include(./partials/footer.paml) -->
		<!-- @raw -->
		<pre>literal @if(kept) and @(kept)</pre>
		<!-- @end -->
		<p: literal \@(escaped) and @@(directive)
</html>
