# Showcase: Kash actions, bindings, control flow, and process graphs.
def label name = uppercase name
let title = "Little publication"
let names = ["hello world.txt", "second.txt"]
let files = [./one.txt, ./two.txt]

echo "Hello, $title"
cat $...files | wc -l
git status --short
cwd: ./build timeout: 5 env: $exports NODE_ENV: production npm test
let result = $?(grep -q needle ./sample.txt)
grep -q needle ./sample.txt || echo "no needle"
let job = $&(watch-assets --port 8080)
let message = $(printf payload >&out && printf "progress\n" >&err)

for source in files
	echo $source

while $?(test -f ./ready).ok
	sleep 1

match ./notes/intro.txt
	./notes/{name:*}.txt =>
		echo $name
	else =>
		echo unknown

defer rm -rf $workspace
with cwd: ./project env: $exports
	configure

stream reports
producer |(merge) sort
producer |(frame :lines) |(broadcast :buffer 4096) (cat > ./a, cat > ./b)
producer |(tee :append ./audit) |(each) worker
printf "%s\n" $...names >&out
echo redirect > ./out.txt && cat < ./out.txt >> ./log.txt
(producer >&reports, &reports | consumer)
